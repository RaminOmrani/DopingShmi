{
  "name": "doping-shimi",
  "private": true,
  "version": "1.0.0",
  "description": "دوپینگ شیمی - سایت، اپلیکیشن (PWA) و پنل آموزشی استاد جواد پرتویی",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "icons": "tsx scripts/make-icons.ts",
    "postinstall": "prisma generate"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "prisma",
      "@prisma/engines",
      "esbuild"
    ]
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.4",
    "exceljs": "^4.4.0",
    "hls.js": "^1.7.3",
    "jalaali-js": "^2.0.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jalaali-js": "^1.2.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
